{
  "name": "companion-module-lz-scopes",
  "version": "0.1.0",
  "private": true,
  "description": "Bitfocus Companion module for LZ Scopes (control API of the bridge)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "sync": "npm run build && node scripts/sync-dev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@companion-module/base": "~1.14.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED",
  "author": "Lars Zumpe"
}
