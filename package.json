{
  "name": "lz-scopes",
  "version": "0.1.0",
  "private": true,
  "description": "Software waveform monitor, vectorscope, histogram and CIE scope in the browser, with RTSP/network inputs via an ffmpeg bridge",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web \"node server/index.mjs --dev\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lang:check": "node scripts/lang-check.mjs",
    "build:helpers": "node scripts/build-helpers.mjs",
    "electron:dev": "vite build && electron .",
    "ffmpeg:fetch": "node scripts/ffmpeg-fetch.mjs",
    "decklink:fetch": "node scripts/decklink-sdk-fetch.mjs",
    "dist:mac": "npm run build && node scripts/ffmpeg-fetch.mjs darwin-universal && node scripts/decklink-sdk-fetch.mjs && node scripts/build-helpers.mjs colorsync ndi decklink && electron-builder --config electron-builder.js --mac --universal --publish never",
    "dist:win": "npm run build && node scripts/ffmpeg-fetch.mjs win32-x64 && electron-builder --config electron-builder.js --win --publish never",
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "companion:test": "npm --prefix companion test",
    "companion:build": "npm --prefix companion run build",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "bonjour-service": "^1.4.4",
    "dockview-core": "^8.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.cjs",
  "author": "Lars Zumpe"
}
